# SQL Server
SQL_SA_PASSWORD=ChangeThisStrongPassword123!

# Initial Admin
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeThisAdminPassword123!

# JWT
JWT_KEY=replace-with-at-least-32-characters-secret-key

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM_EMAIL=your-email@example.com

# Geoapify
GEOAPIFY_API_KEY=your-geoapify-api-key

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=your-storage-account

# Required by DefaultAzureCredential when running locally in Docker
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=